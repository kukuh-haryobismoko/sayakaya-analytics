GCP_PROJECT_ID=sayakaya
# Local dev only — Cloud Run doesn't need this, it uses Application Default
# Credentials from its runtime service account instead. See README.md.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
PORT=8080
MAX_BYTES_BILLED=15000000000
BQ_LOCATION=asia-southeast2

# Legacy — no longer read anywhere, safe to leave unset.
APP_PASSWORD=

ANTHROPIC_API_KEY=

# Per-user login (accounts + sessions live in Supabase Postgres).
SUPABASE_URL=https://josptpfisrsdjeggkqke.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheet export (Portfolio tab): create a Sheet, share it with
# syky-big-query@sayakaya.iam.gserviceaccount.com as Editor, then paste the
# ID from its URL here — https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GSHEET_TRACKER_ID=

# Amazon SES SMTP (IAM SMTP credentials, ap-southeast-1) — for monthly portfolio
# statement emails. SMTP_USER/SMTP_PASS come from the "Retrieve SMTP credentials"
# step, not your AWS IAM access key. SMTP_FROM must be a verified SES identity.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sayakaya <report@sayakaya.id>"

# Shared secret for POST /api/cron/run-due-schedules and /api/cron/retrain-models.
# Whatever triggers those on a timer must send this same value in the
# X-Cron-Key header.
CRON_SECRET=

# Ask Kukuh (tech@sayakaya.id) for the real values above — never commit them.
# For deploying to the existing Cloud Run service, you don't need this file
# at all: env vars and secrets already live on the service itself.
